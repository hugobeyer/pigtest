float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

void face(int pts[]){ setprimgroup(0,"rock",addprim(0,"poly",pts),1); }

void rock(vector c; float size; float flat; float h; float asym; float bump; int sides; int rings; float seed; float id){
    vector lean=set(rnd(seed,id,1)-0.5,0,rnd(seed,id,2)-0.5)*asym*size;
    int top=addpoint(0,c+set(0,h*size,0)+lean), bottom=addpoint(0,c), ring[];
    for(int j=1;j<rings;j++)for(int i=0;i<sides;i++){
        float u=2*PI*i/sides+(rnd(seed,id,j*40+i)-0.5)*1.2/sides;
        float t=j/float(rings), k=1+(rnd(seed,id,1000+j*40+i)-0.5)*2*bump;
        float radial=t>0.5 ? lerp(sin(PI*t),1,flat) : sin(PI*t);
        vector p=set(radial*cos(u)*size*(1+asym*cos(u)*0.3),h*size*(1-t),radial*sin(u)*size*(1+asym*sin(u)*0.2));
        append(ring,addpoint(0,c+p*k+lean*(1-t)));
    }
    for(int i=0;i<sides;i++){
        int n=(i+1)%sides, last=(rings-2)*sides;
        face(array(top,ring[n],ring[i]));
        face(array(bottom,ring[last+i],ring[last+n]));
        for(int j=0;j<rings-2;j++)face(array(ring[j*sides+i],ring[j*sides+n],ring[(j+1)*sides+n],ring[(j+1)*sides+i]));
    }
}

float seed=chi("seed");
int sides=max(chi("sides"),3), rings=max(chi("rings"),3), extra=chi("small_rocks");
float size=chf("size"), flat=chf("flatten"), h=chf("height"), asym=chf("asymmetry"), bump=chf("bumpiness"), smallSize=chf("small_size");

rock(set(0,0,0),size,flat,h,asym,bump,sides,rings,seed,1);
for(int i=0;i<extra;i++){
    float a=rnd(seed,2,i)*2*PI, s=size*smallSize*(0.6+rnd(seed,3,i)*0.6);
    rock(set(cos(a),0,sin(a))*size*(0.7+rnd(seed,4,i)*0.4),s,flat,h,asym,bump,sides,rings,seed,10+i);
}
