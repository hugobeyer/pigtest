float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

int seed=chi("seed"), iters=chi("iterations"), res=max(chi("resolution"),3), nsamp=max(chi("samples"),64), hullN=max(chi("hull_facets"),4);
float W=chf("width"), H=chf("height"), D=chf("depth"), diag=chf("diagonal"), vbias=chf("vertical_bias"), randomness=chf("split_randomness");
float chance=chf("split_chance"), minPiece=chf("min_piece"), gap=chf("gap"), sharp=chf("sharpness"), jitter=chf("facet_jitter");
vector R=set(W,H,D);
float scale=max(W,max(H,D));

vector PN[]; float PD[];
for(int i=0;i<hullN;i++){
    float y=1-(i+0.5)/hullN, r=sqrt(max(0,1-y*y)), a=i*2.39996;
    vector n=normalize(set(cos(a)*r,y,sin(a)*r)+(set(rnd(seed,1,i),rnd(seed,2,i),rnd(seed,3,i))-0.5)*jitter);
    append(PN,n); append(PD,length(n*R)*(1+(rnd(seed,4,i)-0.5)*jitter*0.4));
}
append(PN,set(0,-1,0)); append(PD,0);

vector S[];
for(int t=0;t<nsamp*8 && len(S)<nsamp;t++){
    vector p=(set(rnd(seed,5,t),rnd(seed,6,t),rnd(seed,7,t))*2-1)*R;
    p.y=abs(p.y);
    int inside=1;
    for(int k=0;k<len(PN);k++)if(dot(PN[k],p)>PD[k])inside=0;
    if(inside)append(S,p);
}

int idx[], start[], count[];
for(int k=0;k<len(PN);k++)append(idx,k);
append(start,0); append(count,len(PN));

for(int it=0;it<iters;it++){
    int nidx[], nstart[], ncount[];
    for(int c=0;c<len(start);c++){
        vector m[];
        foreach(vector p; S){
            int inside=1;
            for(int k=0;k<count[c];k++)if(dot(PN[idx[start[c]+k]],p)>PD[idx[start[c]+k]])inside=0;
            if(inside)append(m,p);
        }
        int own[];
        for(int k=0;k<count[c];k++)append(own,idx[start[c]+k]);
        if(len(m)<8 || len(m)/float(len(S))<minPiece || rnd(seed,8,it*997+c)>chance){
            append(nstart,len(nidx)); append(ncount,len(own)); foreach(int k; own)append(nidx,k);
            continue;
        }
        vector centre=0;
        foreach(vector p; m)centre+=p;
        centre/=len(m);
        vector best=set(0,1,0); float spread=-1;
        for(int t=0;t<6;t++){
            vector v=normalize((set(rnd(seed,9,it*97+c*7+t),rnd(seed,10,it*97+c*7+t),rnd(seed,11,it*97+c*7+t))-0.5)*set(1,1+vbias,1));
            vector a=abs(v.x)>abs(v.y) && abs(v.x)>abs(v.z) ? set(sign(v.x),0,0) : abs(v.y)>abs(v.z) ? set(0,sign(v.y),0) : set(0,0,sign(v.z));
            vector n=normalize(lerp(a,v,diag));
            float lo=1e9, hi=-1e9;
            foreach(vector p; m){ float d=dot(n,p); lo=min(lo,d); hi=max(hi,d); }
            if(hi-lo>spread){ spread=hi-lo; best=n; }
        }
        float d=dot(best,centre)+(rnd(seed,12,it*97+c)-0.5)*randomness*spread*0.5;
        append(PN,best); append(PD,d-gap*0.5);
        append(PN,-best); append(PD,-d-gap*0.5);
        foreach(int side; array(len(PN)-2,len(PN)-1)){
            append(nstart,len(nidx)); append(ncount,len(own)+1);
            foreach(int k; own)append(nidx,k);
            append(nidx,side);
        }
    }
    idx=nidx; start=nstart; count=ncount;
}

for(int c=0;c<len(start);c++){
    vector centre=0; int hits=0;
    foreach(vector p; S){
        int inside=1;
        for(int k=0;k<count[c];k++)if(dot(PN[idx[start[c]+k]],p)>PD[idx[start[c]+k]])inside=0;
        if(inside){ centre+=p; hits++; }
    }
    if(hits==0)continue;
    centre/=hits;
    int top=-1, bottom=-1, ring[];
    for(int j=0;j<=res;j++)for(int i=0;i<(j==0 || j==res ? 1 : res*2);i++){
        float v=PI*j/res, u=PI*i/res, sum=0;
        vector dir=set(sin(v)*cos(u),cos(v),sin(v)*sin(u));
        for(int k=0;k<count[c];k++){
            int pl=idx[start[c]+k];
            float dn=dot(dir,PN[pl]);
            if(dn>1e-3)sum+=exp(-sharp*max(PD[pl]-dot(PN[pl],centre),0.001)/(dn*scale));
        }
        int pt=addpoint(0,centre+dir*(-log(max(sum,1e-12))*scale/sharp));
        if(j==0)top=pt; else if(j==res)bottom=pt; else append(ring,pt);
    }
    int sides=res*2, last=(res-2)*sides, prims[];
    for(int i=0;i<sides;i++){
        int nx=(i+1)%sides;
        append(prims,addprim(0,"poly",array(top,ring[nx],ring[i])));
        append(prims,addprim(0,"poly",array(bottom,ring[last+i],ring[last+nx])));
        for(int j=0;j<res-2;j++)append(prims,addprim(0,"poly",array(ring[j*sides+i],ring[j*sides+nx],ring[(j+1)*sides+nx],ring[(j+1)*sides+i])));
    }
    foreach(int pr; prims){ setprimgroup(0,"rock",pr,1); setprimattrib(0,"piece",pr,c); }
}
