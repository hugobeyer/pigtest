float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

float seed=chi("seed");
int petals=chi("petals"), sides=max(chi("sides"),3);
float plen=chf("petal_length"), pwid=chf("petal_width"), cr=chf("center_radius"), cup=radians(chf("cup")), jitter=chf("jitter"), y=chf("head_height");

int ring[];
for(int i=0;i<sides;i++){ float u=-2*PI*i/sides; append(ring,addpoint(0,set(cos(u)*cr,y+plen*0.05,sin(u)*cr))); }
setprimgroup(0,"center",addprim(0,"poly",ring),1);

for(int p=0;p<petals;p++){
    float a=2*PI*p/max(petals,1)+(rnd(seed,1,p)-0.5)*jitter;
    float l=plen*(1+(rnd(seed,2,p)-0.5)*jitter), w=pwid*(1+(rnd(seed,3,p)-0.5)*jitter);
    vector out=set(cos(a),0,sin(a)), side=set(-sin(a),0,cos(a));
    int pts[];
    for(int i=0;i<=sides*2;i++){
        float u=PI*i/(sides*2);
        float along=cr*0.6+(l*0.5)*(1-cos(u)), across=w*0.5*pow(sin(u),0.55);
        append(pts,addpoint(0,out*along+side*across*(1-0.35*cos(u))+set(0,y+sin(cup)*along,0)));
    }
    for(int i=sides*2-1;i>0;i--){
        float u=PI*i/(sides*2);
        float along=cr*0.6+(l*0.5)*(1-cos(u)), across=w*0.5*pow(sin(u),0.55);
        append(pts,addpoint(0,out*along-side*across*(1-0.35*cos(u))+set(0,y+sin(cup)*along,0)));
    }
    setprimgroup(0,"petal",addprim(0,"poly",pts),1);
}
