float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

void box(vector c; vector h; vector4 q; string grp){
    int p[];
    for(int i=0;i<8;i++)append(p,addpoint(0,c+qrotate(q,set(i&1?h.x:-h.x,i&2?h.y:-h.y,i&4?h.z:-h.z))));
    int f[]={0,1,3,2, 4,6,7,5, 0,4,5,1, 2,3,7,6, 0,2,6,4, 1,5,7,3};
    for(int i=0;i<6;i++)setprimgroup(0,grp,addprim(0,"poly",array(p[f[i*4]],p[f[i*4+1]],p[f[i*4+2]],p[f[i*4+3]])),1);
}

float seed=chi("seed");
int posts=max(chi("posts"),2), rails=chi("rails");
float spacing=chf("spacing"), ph=chf("post_height"), pw=chf("post_width"), rh=chf("rail_thickness"), rd=chf("rail_depth");
float lo=chf("rail_low"), hi=chf("rail_high"), jitter=chf("jitter"), lean=radians(chf("lean")), skew=chf("skew");

vector tops[];
for(int i=0;i<posts;i++){
    float h=ph*(1+(rnd(seed,1,i)-0.5)*2*jitter);
    vector4 q=qmultiply(quaternion((rnd(seed,2,i)-0.5)*2*lean,set(0,0,1)),quaternion((rnd(seed,3,i)-0.5)*2*lean,set(1,0,0)));
    vector base=set(i*spacing+(rnd(seed,4,i)-0.5)*jitter*spacing,0,(rnd(seed,5,i)-0.5)*jitter*pw);
    box(base+qrotate(q,set(0,h*0.5,0)),set(pw,h,pw)*0.5,q,"post");
    append(tops,base);
}
for(int i=0;i<posts-1;i++)for(int k=0;k<rails;k++){
    float t=rails>1 ? k/(rails-1.0) : 0.5;
    vector a=tops[i]+set(0,ph*lerp(lo,hi,t)+(rnd(seed,6,i*10+k)-0.5)*skew,pw*0.5+rd*0.5);
    vector b=tops[i+1]+set(0,ph*lerp(lo,hi,t)+(rnd(seed,7,i*10+k)-0.5)*skew,pw*0.5+rd*0.5);
    vector d=b-a;
    box((a+b)*0.5,set(length(d)*0.5+pw*0.4,rh*0.5,rd*0.5),dihedral(set(1,0,0),normalize(d)),"rail");
}
