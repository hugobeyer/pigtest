float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

float seed=chi("seed");
int blades=chi("blades"), segs=max(chi("segments"),2);
float height=chf("height"), width=chf("width"), spread=radians(chf("spread")), jitter=chf("jitter"), taper=chf("taper");

for(int b=0;b<blades;b++){
    float a=2*PI*b/max(blades,1)+(rnd(seed,1,b)-0.5)*jitter*2;
    float h=height*(1-rnd(seed,2,b)*jitter)*(b==0 ? 1 : 0.8);
    float w=width*(1+(rnd(seed,3,b)-0.5)*jitter);
    float tilt=b==0 ? 0 : spread*(0.5+rnd(seed,4,b)*0.5);
    vector out=set(cos(a),0,sin(a)), side=set(-sin(a),0,cos(a));
    vector up=set(0,cos(tilt),0)+out*sin(tilt);
    int pts[];
    for(int s=0;s<=segs;s++){ float t=s/float(segs); append(pts,addpoint(0,up*h*t+side*w*0.5*pow(sin(PI*lerp(0.5,1,t)),taper))); }
    for(int s=segs-1;s>=0;s--){ float t=s/float(segs); append(pts,addpoint(0,up*h*t-side*w*0.5*pow(sin(PI*lerp(0.5,1,t)),taper))); }
    setprimgroup(0,"blade",addprim(0,"poly",pts),1);
}
