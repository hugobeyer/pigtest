float rnd(float seed; float i; float k){ float v=rand(set(seed+0.37,i*3.14+0.11,k*2.71+0.53)); return v; }

void face(int pts[]; string grp){ setprimgroup(0,grp,addprim(0,"poly",pts),1); }

void blob(vector c; vector r; vector4 q; int sides; int rings; string grp){
    int top=addpoint(0,c+qrotate(q,set(0,r.y,0))), bottom=addpoint(0,c-qrotate(q,set(0,r.y,0))), ring[];
    for(int j=1;j<rings;j++)for(int i=0;i<sides;i++){
        float v=PI*j/rings, u=2*PI*i/sides;
        append(ring,addpoint(0,c+qrotate(q,set(sin(v)*cos(u)*r.x,cos(v)*r.y,sin(v)*sin(u)*r.z))));
    }
    for(int i=0;i<sides;i++){
        int n=(i+1)%sides, last=(rings-2)*sides;
        face(array(top,ring[n],ring[i]),grp);
        face(array(bottom,ring[last+i],ring[last+n]),grp);
        for(int j=0;j<rings-2;j++)face(array(ring[j*sides+i],ring[j*sides+n],ring[(j+1)*sides+n],ring[(j+1)*sides+i]),grp);
    }
}

float seed=chi("seed");
float height=chf("trunk_height"), rb=chf("trunk_radius"), rt=chf("trunk_top_radius"), flare=chf("flare"), lean=chf("lean");
int tsides=max(chi("trunk_sides"),3), tsegs=max(chi("trunk_segments"),1);
float R=chf("canopy_radius"), bmin=chf("blob_min"), bmax=chf("blob_max"), squash=chf("blob_squash");
int blobs=chi("blobs"), csides=max(chi("canopy_sides"),3), crings=max(chi("canopy_rings"),2);
vector bend=set(rnd(seed,1,0)-0.5,0,rnd(seed,1,1)-0.5)*2*lean;

int rings[];
for(int j=0;j<=tsegs;j++){
    float t=j/float(tsegs), r=lerp(rb,rt,t)*(1+flare*pow(1-t,3));
    vector c=set(0,t*height,0)+bend*t*t;
    for(int i=0;i<tsides;i++){
        float u=2*PI*i/tsides, k=1+(rnd(seed,2,j*50+i)-0.5)*0.12;
        append(rings,addpoint(0,c+set(cos(u),0,sin(u))*r*k));
    }
}
int cap[];
for(int i=0;i<tsides;i++){
    int n=(i+1)%tsides;
    for(int j=0;j<tsegs;j++)face(array(rings[j*tsides+i],rings[j*tsides+n],rings[(j+1)*tsides+n],rings[(j+1)*tsides+i]),"trunk");
    append(cap,rings[tsegs*tsides+i]);
}
face(cap,"trunk");

vector c=set(0,height,0)+bend+set(0,R*0.45,0);
blob(c,set(R*0.8,R*0.6,R*0.8),quaternion(rnd(seed,3,0)*2*PI,set(0,1,0)),csides,crings,"canopy");
for(int i=0;i<blobs;i++){
    float y=lerp(0.9,-0.4,(i+rnd(seed,4,i)*0.6-0.3)/max(blobs-1,1)), a=i*2.39996+(rnd(seed,5,i)-0.5)*0.9, ring=sqrt(max(0,1-y*y));
    float s=R*lerp(bmin,bmax,rnd(seed,6,i));
    vector d=set(cos(a)*ring,y,sin(a)*ring);
    blob(c+set(d.x*R*0.75,d.y*R*0.55,d.z*R*0.75),set(s,s*squash,s),qmultiply(dihedral(set(0,1,0),normalize(d)),quaternion(rnd(seed,7,i)*2*PI,set(0,1,0))),csides,crings,"canopy");
}
